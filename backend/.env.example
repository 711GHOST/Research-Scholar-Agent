# Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB connection string (do NOT commit the real value)
MONGODB_URI=mongodb://localhost:27017/research_scholar_agent

# Semantic Scholar API key (optional, raises rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# JWT — use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# AI Service
AI_SERVICE_URL=http://localhost:8000
# Shared secret the backend sends to the AI service (must match ai-service/.env)
AI_SERVICE_SECRET=replace-with-a-shared-internal-secret

# CORS — comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000

# Max upload size in bytes (default 25MB)
MAX_UPLOAD_BYTES=26214400

# App display name (used in OTP emails/SMS)
APP_NAME=Research Scholar Agent

# OTP delivery. Leave providers blank to run in dev mode (the code is returned
# in the API response and logged). Set OTP_DEV_MODE=false to require a provider.
OTP_DEV_MODE=true

# Email (SMTP) for OTP / verification — e.g. Gmail app password or SendGrid
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS (Twilio) for phone OTP — requires `npm i twilio`
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Payments (Razorpay). Leave blank to run subscriptions in MOCK mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
