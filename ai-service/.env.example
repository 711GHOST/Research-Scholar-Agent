# Google Gemini API key (optional - without it the service runs in offline mode)
GEMINI_API_KEY=

# Semantic Scholar API key (optional)
SEMANTIC_SCHOLAR_API_KEY=

# App config
PORT=8000
DEBUG=False

# Shared secret required from the backend (must match backend/.env)
AI_SERVICE_SECRET=replace-with-a-shared-internal-secret

# Origins allowed to call this service directly (the backend only)
AI_ALLOWED_ORIGINS=http://localhost:5000
