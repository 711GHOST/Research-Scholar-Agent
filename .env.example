# Root .env used by docker-compose for variable substitution.
# Copy to `.env` and fill in real values (the .env file is gitignored).

# Use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret

# Shared secret between backend and AI service (any long random string)
AI_SERVICE_SECRET=replace-with-a-shared-internal-secret

# Google Gemini API key (optional - without it the AI service runs offline)
GEMINI_API_KEY=

# Semantic Scholar API key (optional, raises search rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Override the Mongo URI to use Atlas instead of the bundled container
# MONGODB_URI=mongodb+srv://user:pass@cluster/db

# Allowed frontend origin(s), comma-separated
FRONTEND_URL=http://localhost:3000
